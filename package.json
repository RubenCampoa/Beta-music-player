{
  "name": "beta-music-player",
  "version": "1.0.3",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run start-api\" \"vite\"",
    "build": "tsc && vite build && electron-builder --win",
    "preview": "vite preview",
    "start-api": "node server.js"
  },
  "build": {
    "appId": "com.beta.musicplayer",
    "productName": "Beta Music Player",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      "public/icon.png"
    ],
    "asarUnpack": [
      "**/node_modules/@neteasecloudmusicapienhanced/**"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ],
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@neteasecloudmusicapienhanced/api": "latest",
    "@types/jsmediatags": "^3.9.6",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dexie": "^4.0.8",
    "express": "^4.19.2",
    "framer-motion": "^11.3.24",
    "jsmediatags": "^3.9.7",
    "lucide-react": "^0.428.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.2.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.1",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
